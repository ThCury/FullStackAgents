{
  "info": {
    "_postman_id": "d27e55ad-337d-4ae6-8e18-fd36c28fc6e1",
    "name": "FullStack Agents API",
    "description": "Projetos persistentes, runs auditáveis e agentes LangGraph.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Runs",
      "item": [
        {
          "name": "Listar runs (resumo curto)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/runs"
          }
        },
        {
          "name": "Criar run do PO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('run_id', response.run_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Quero criar um portal para clientes consultarem suas apólices.\",\n  \"project_name\": \"portal-clientes\",\n  \"requested_by_id\": \"thiago\",\n  \"requested_by_name\": \"Thiago\"\n}"
            },
            "url": "{{base_url}}/runs"
          }
        },
        {
          "name": "Consultar resumo do run (padrão)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/runs/{{run_id}}"
          }
        },
        {
          "name": "Consultar run completa",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/runs/{{run_id}}?dataset=full"
          }
        },
        {
          "name": "Consultar resultado do PO",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/runs/{{run_id}}/result"
          }
        },
        {
          "name": "Consultar auditoria do run",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/runs/{{run_id}}/audit"
          }
        }
      ]
    },
    {
      "name": "Projetos",
      "item": [
        {
          "name": "Criar projeto e primeira run",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('project_id', response.project_id);",
                  "pm.collectionVariables.set('run_id', response.run_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"calculadora-lucro\",\n  \"prompt\": \"Crie uma calculadora de lucro líquido.\",\n  \"requested_by_id\": \"thiago\",\n  \"requested_by_name\": \"Thiago\"\n}"
            },
            "url": "{{base_url}}/projects"
          }
        },
        {
          "name": "Enviar mensagem para continuar projeto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('run_id', response.run_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Adicione uma explicação visual do lucro.\",\n  \"requested_by_id\": \"thiago\",\n  \"requested_by_name\": \"Thiago\"\n}"
            },
            "url": "{{base_url}}/projects/{{project_id}}/messages"
          }
        },
        {
          "name": "Repetir run falhada do projeto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('run_id', response.run_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retry_run_id\": \"{{run_id}}\"\n}"
            },
            "url": "{{base_url}}/projects/{{project_id}}/messages"
          }
        },
        {
          "name": "Consultar projeto",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/projects/{{project_id}}" }
        },
        {
          "name": "Listar mensagens do projeto",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/projects/{{project_id}}/messages" }
        },
        {
          "name": "Listar runs do projeto",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/projects/{{project_id}}/runs" }
        }
      ]
    }
  ]
}

# URL da API do Squad. Em dev o vite.config.ts já faz proxy para
# http://127.0.0.1:8000, então normalmente não precisa definir isso.
# Evite `localhost`: clientes Node/Electron podem resolvê-lo como ::1 (IPv6),
# enquanto o uvicorn está escutando em 127.0.0.1 (IPv4).
VITE_API_URL=http://127.0.0.1:8000

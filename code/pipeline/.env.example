ANTHROPIC_API_KEY=

# Opcional: modelo padrão para todos os agentes
PIPELINE_MODEL=claude-sonnet-5

# Opcional: modelo específico por agente (sobrescreve PIPELINE_MODEL)
# ANALYST_MODEL=claude-sonnet-5
# PO_MODEL=claude-sonnet-5
# DEV_MODEL=claude-sonnet-5
# QA_MODEL=claude-sonnet-5

# Opcional: quantas vezes o QA pode rejeitar a mesma story antes de escalar
PIPELINE_MAX_REVISIONS=2

# Opcional: limite de iterações de tool-use por chamada de agente
PIPELINE_MAX_TOOL_ITERATIONS=20

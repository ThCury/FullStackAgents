ANTHROPIC_API_KEY=

# Opcional: modelo padrão para todos os agentes
PIPELINE_MODEL=claude-sonnet-5

# Opcional: modelo específico por agente (sobrescreve PIPELINE_MODEL)
# ANALYST_MODEL=claude-sonnet-5
# PO_MODEL=claude-sonnet-5
# DEV_MODEL=claude-sonnet-5
# QA_MODEL=claude-sonnet-5

# Opcional: quantas vezes o QA pode rejeitar a mesma story antes de escalar
# (loop Dev <-> QA por story - diferente do limite de tool-use abaixo)
PIPELINE_MAX_REVISIONS=2

# Opcional: limite de chamadas de ferramenta dentro de UMA invocação de
# agente (list_dir/read_file/write_file/run_*_tests). Ao atingir o limite,
# o agente não tenta de novo: Dev entrega o que já escreveu até ali e QA
# aprova automaticamente, sem correção - evita travar em loop.
PIPELINE_MAX_TOOL_ITERATIONS=20
# Opcional: limite específico por agente (sobrescreve PIPELINE_MAX_TOOL_ITERATIONS)
# ANALYST_MAX_TOOL_ITERATIONS=20
# PO_MAX_TOOL_ITERATIONS=20
# DEV_MAX_TOOL_ITERATIONS=20
# QA_MAX_TOOL_ITERATIONS=15

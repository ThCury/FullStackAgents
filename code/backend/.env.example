# fake permite rodar e testar sem chave de API ou MongoDB.
SQUAD_LLM_MODE=fake
SQUAD_PERSISTENCE=memory

# Para usar MongoDB:
# SQUAD_PERSISTENCE=mongo
# SQUAD_MONGODB_URI=mongodb://localhost:27017
# SQUAD_MONGODB_DATABASE=fullstack_agents

# LLMs tokens:
# SQUAD_OPENAI_API_KEY=...
# SQUAD_OPENAI_MODEL=<modelo configurado na sua conta>
# SQUAD_OPENAI_EFFORT=medium

# Intervalo mínimo entre gravações parciais de streaming.
SQUAD_STREAM_PERSIST_INTERVAL_MS=500

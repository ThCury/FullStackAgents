ANTHROPIC_API_KEY=

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=squad_db

# Modelo padrão para todos os agentes (sobrescrevível por agente abaixo).
# Decisão registrada com o usuário: mantido configurável por agente em vez de
# fixar claude-opus-5 (ADR-05 original) - ver docs/adr/0001-modelo-configuravel-por-agente.md
PIPELINE_MODEL=claude-sonnet-5
# ANALYST_MODEL=claude-sonnet-5
# PO_MODEL=claude-sonnet-5
# DEV_MODEL=claude-sonnet-5
# QA_MODEL=claude-sonnet-5

# Dial de custo por agente (§8.4): low | medium | high | xhigh
ANALYST_EFFORT=medium
PO_EFFORT=high
DEV_EFFORT=high
QA_EFFORT=medium

# Orçamento (§8.3, decisão do usuário: $5/run)
BUDGET_PER_RUN_USD=5.0
BUDGET_PER_AGENT_USD=3.0
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

PIPELINE_MAX_REVISIONS=3
PIPELINE_MAX_TOOL_ITERATIONS=20

# ADR-08: sandbox Docker para execução de código gerado pelo Dev Agent
DOCKER_SANDBOX_BACKEND_IMAGE=python:3.11-slim
DOCKER_SANDBOX_FRONTEND_IMAGE=node:20-slim
DOCKER_SANDBOX_TIMEOUT_SECONDS=180

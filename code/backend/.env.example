# Copie para .env e ajuste. Todos os defaults do codigo rodam SEM nada disso:
# `SQUAD_LLM=fake` + `SQUAD_PERSISTENCE=memory` nao precisam de API key nem banco.

# --- modos de operacao -------------------------------------------------------
# fake | anthropic
SQUAD_LLM=fake
# memory | mongo
SQUAD_PERSISTENCE=memory
# none | subprocess | docker   (docker ainda nao implementado — ver ADR-08)
SQUAD_SANDBOX=none

# --- modelo ------------------------------------------------------------------
SQUAD_MODEL=claude-opus-5
# Necessario apenas com SQUAD_LLM=anthropic
ANTHROPIC_API_KEY=

# --- Mongo (apenas com SQUAD_PERSISTENCE=mongo) -------------------------------
SQUAD_MONGO_URI=mongodb://localhost:27017
SQUAD_MONGO_DB=squad_db

# --- workspace do codigo gerado ----------------------------------------------
# Default: <raiz-do-repo>/.workspaces (fora de code/backend, para o
# --reload do uvicorn nao reiniciar quando o Dev Agent escreve arquivo)
# SQUAD_WORKSPACE_ROOT=
SQUAD_USE_GIT=true

# --- fluxo -------------------------------------------------------------------
# Reprovacoes na mesma story antes de escalar para humano
SQUAD_MAX_REWORK_CYCLES=3
SQUAD_TEST_TIMEOUT_SECONDS=120

# --- orcamento de tokens (3 escopos) -----------------------------------------
SQUAD_BUDGET_PER_RUN=2000000
SQUAD_BUDGET_PER_AGENT=800000
SQUAD_BUDGET_PER_CALL=200000
